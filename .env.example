# Copy this file to ".env" and fill in your values. ".env" is git-ignored: it exists only on your server.
# Put comments on their own lines (not after a value) - Docker would treat trailing text as part of the value.
# Anything you leave out uses the built-in default shown in README.md.

# ---- required ----
# Your time zone (IANA name), used for display and the Thursday preview time
TZ=America/New_York
# A long random name; anyone who knows it can read your alerts, so treat it like a password
NTFY_TOPIC=CHANGE-ME-long-random-topic

# ---- Unraid Docker tab icon (optional) ----
# The container serves its own icon; use your server's LAN address
ICON_URL=http://YOUR-UNRAID-IP:8099/icon.png

# ---- optional: second notification button that opens the NASCAR mobile app ----
# Use ONE of the next two settings (iPhone or Android). To turn one on, delete only the "# " in front of it.
# iPhone, via a Shortcuts shortcut named NASCAR:
# APP_URL=shortcuts://run-shortcut?name=NASCAR
# Android, via a MacroDroid or Tasker macro that listens for this name:
# APP_INTENT=com.nascarcheckin.OPEN_APP
# Optional custom button text:
# APP_LABEL=Open NASCAR app

# ---- optional: "Checked in" button that stops the follow-up nudges ----
# ACK_TOKEN=CHANGE-ME-another-random-string
# ACK_BASE_URL=http://YOUR-UNRAID-TAILSCALE-IP:8099

# ---- optional: daily reminder to earn dashboard game points ----
# One notification a day at DAILY_REMINDER_TIME (your local time, 24-hour). By default it is sent every day.
# To name a day's game, delete the "# " in front of that day's line and type the game after the = sign.
# A day left commented out (or empty) gets the generic reminder without a game name.
# To turn the daily reminder off completely, set DAILY_REMINDER=0.
# DAILY_REMINDER=1
# DAILY_REMINDER_TIME=22:00
# Set to 1 to send the reminder only on days that have a game below.
# DAILY_ONLY_CONFIGURED=0
# Page the notification opens (defaults to the leaderboard link).
# DASHBOARD_URL=
# GAME_MON=Trivia
# GAME_TUE=
# GAME_WED=
# GAME_THU=
# GAME_FRI=
# GAME_SAT=
# GAME_SUN=

# ---- optional tuning (defaults shown) ----
# ALERT_MODE=auto
# FIRST_ALERT_MIN=10
# SCHED_FALLBACK_MIN=90
# HOT_GRACE_MIN=45
# NUDGE_MIN=45
# NUDGES=1
# FALLBACK_LIVE_HOURS=2
# PREVIEW=1
# PREVIEW_DAY=thu
# PREVIEW_TIME=18:00
# EXCLUDE_NAMES=arca
# QUIET_DAYS=mon,tue,wed,thu
# QUIET_START_HOUR=22
# QUIET_END_HOUR=6
# QUIET_OVERRIDE=1
# SERIES=cup,xfinity,truck